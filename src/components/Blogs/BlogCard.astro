---
import Category from '../Badges/Category.astro';
import { basePath } from '../../utils/paths';

interface Props {
  title: string;
  description: string;
  publishDate: Date;
  tags: string[];
  slug: string;
  readTime: string;
  series?: {
    id: string;
    title?: string;
    part: number;
  };
}

const { title, description, publishDate, tags, slug, readTime, series } = Astro.props;

const formattedDate = publishDate.toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="telemetry-card">
    <div>
        <div class="telemetry-card-header">
            <div class="flex items-center gap-1 flex-wrap">
                {tags.slice(0, 2).map(tag => (
                    <Category category={tag} text={tag} />
                ))}
                {series && (
                    <span class="badge badge-amber font-mono" style="font-size: 0.68rem; padding: 0.1rem 0.4rem;">
                        SERIE // PT {series.part}
                    </span>
                )}
            </div>
            <span class="badge badge-amber font-mono" style="font-size: 0.72rem;">
                {readTime}
            </span>
        </div>
        
        <h3 class="telemetry-card-title">
            <a href={`${basePath}/blog/${slug}`}>
                {title}
            </a>
        </h3>
    </div>
    
    <p class="telemetry-card-desc">
        {description}
    </p>
    
    <div class="telemetry-card-footer">
        <time datetime={publishDate.toISOString()} class="flex items-center gap-1">
            <span class="led-dot led-cyan" style="width: 4px; height: 4px;"></span>
            {formattedDate}
        </time>
        
        <a href={`${basePath}/blog/${slug}`} class="btn btn-outline btn-sm" style="font-size: 0.72rem; padding: 0.2rem 0.6rem;">
            [ REPORTE → ]
        </a>
    </div>
</article>