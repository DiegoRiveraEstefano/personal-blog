---
import { basePath } from '../../utils/paths';

export interface SeriesPart {
  slug: string;
  title: string;
  part: number;
  isCurrent: boolean;
}

export interface SeriesData {
  id: string;
  title: string;
  currentPart: number;
  totalParts: number;
  parts: SeriesPart[];
  nextPost: {
    slug: string;
    title: string;
    part: number;
  } | null;
  prevPost?: {
    slug: string;
    title: string;
    part: number;
  } | null;
}

interface Props {
  series: SeriesData;
}

const { series } = Astro.props;
---

<div class="series-nav-panel" style="margin-top: var(--space-12); padding: var(--space-6); background-color: var(--surface-panel); border: 1px solid var(--border-strong); border-radius: var(--radius-md); position: relative; overflow: hidden;">
  <!-- Glow accent -->
  <div style="position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, transparent, var(--signal-amber), transparent);"></div>
  
  <!-- Header -->
  <div class="flex items-center justify-between flex-wrap gap-2" style="margin-bottom: var(--space-4); padding-bottom: var(--space-3); border-bottom: 1px solid var(--border-subtle);">
    <div class="flex items-center gap-2">
      <span class="led-dot led-amber"></span>
      <span class="font-mono text-secondary uppercase" style="font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.05em;">
        // SERIE TÉCNICA // ENTREGA {series.currentPart} DE {series.totalParts}
      </span>
    </div>
    <span class="badge badge-amber font-mono" style="font-size: var(--text-xs);">
      PARTE {series.currentPart} / {series.totalParts}
    </span>
  </div>

  <h2 style="font-size: var(--text-xl); font-weight: 700; margin-bottom: var(--space-2); color: var(--text-primary);">
    {series.title}
  </h2>
  <p class="text-secondary" style="font-size: var(--text-sm); line-height: 1.5; margin-bottom: var(--space-6); max-width: 65ch;">
    Este artículo forma parte de una serie técnica secuencial. Explora el temario completo o continúa con las siguientes entregas a continuación.
  </p>

  <!-- Next Part Highlight Banner (if available) -->
  {series.nextPost && (
    <div style="background-color: var(--surface-raised); border: 1px solid var(--signal-amber); border-radius: var(--radius-sm); padding: var(--space-4); margin-bottom: var(--space-6); display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); flex-wrap: wrap;">
      <div>
        <div class="font-mono text-amber" style="font-size: var(--text-xs); font-weight: 600; margin-bottom: var(--space-1); letter-spacing: 0.04em;">
          [ SIGUIENTE ENTREGA DE LA SERIE ]
        </div>
        <div style="font-size: var(--text-base); font-weight: 600; color: var(--text-primary);">
          Parte {series.nextPost.part}: {series.nextPost.title}
        </div>
      </div>
      <a href={`${basePath}/blog/${series.nextPost.slug}`} class="btn btn-primary btn-sm">
        [ CONTINUAR LEYENDO → ]
      </a>
    </div>
  )}

  <!-- Series Parts Timeline / Roadmap -->
  <div class="series-roadmap" style="display: flex; flex-direction: column; gap: var(--space-2);">
    <div class="font-mono text-muted uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em; margin-bottom: var(--space-1);">
      // ÍNDICE COMPLETO DE LA SERIE:
    </div>
    {series.parts.map((p) => (
      <div 
        style={`display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); padding: var(--space-3) var(--space-4); border-radius: var(--radius-xs); border: 1px solid ${p.isCurrent ? 'var(--signal-amber)' : 'var(--border-subtle)'}; background-color: ${p.isCurrent ? 'oklch(from var(--signal-amber) l c h / 0.08)' : 'var(--surface-raised)'};`}
      >
        <div class="flex items-center gap-3" style="min-width: 0;">
          <span class="font-mono text-secondary" style="font-size: var(--text-xs); font-weight: 700; flex-shrink: 0;">
            0{p.part}.
          </span>
          {p.isCurrent ? (
            <span style="font-size: var(--text-sm); font-weight: 600; color: var(--signal-amber); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
              {p.title}
            </span>
          ) : (
            <a 
              href={`${basePath}/blog/${p.slug}`}
              style="font-size: var(--text-sm); color: var(--text-secondary); text-decoration: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; transition: color var(--transition-snappy);"
              class="series-link"
            >
              {p.title}
            </a>
          )}
        </div>

        <div style="flex-shrink: 0;">
          {p.isCurrent ? (
            <span class="badge badge-amber font-mono" style="font-size: 0.7rem;">
              [ LEYENDO AHORA ]
            </span>
          ) : (
            <a 
              href={`${basePath}/blog/${p.slug}`}
              class="btn btn-outline btn-sm font-mono"
              style="font-size: 0.7rem; padding: 0.15rem 0.5rem;"
            >
              [ LEER PARTE {p.part} → ]
            </a>
          )}
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .series-link:hover {
    color: var(--signal-amber) !important;
  }
</style>
