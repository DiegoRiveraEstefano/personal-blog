---
import { getCollection } from 'astro:content';

const tags = await getCollection('tags');

interface Props {
    category: string;
    text?: string;
}

const { category, text } = Astro.props;

const tagData = tags.find(tag => 
    tag.data.slug.toLowerCase() === category.toLowerCase() || 
    tag.data.name.toLowerCase() === category.toLowerCase()
);
const color = tagData?.data.color || "var(--signal-cyan)";
const label = text || (tagData ? tagData.data.name : category);
---

<span 
    class="badge badge-category"
>
    <span class="led-dot" style={`background-color: ${color}; width: 5px; height: 5px; box-shadow: 0 0 6px ${color};`}></span>
    <span>{label}</span>
</span>