<!-- Industrial Telemetry Console Header -->
<header class="site-header">
    <nav class="container site-nav">
        <!-- Brand / Identity -->
        <a href="/" class="brand-logo">
            <span class="brand-badge">DR_SYS</span>
            <span class="brand-title">Diego Rivera</span>
            <span class="led-dot led-emerald" title="System Status: Online"></span>
        </a>

        <!-- Desktop Navigation -->
        <div class="nav-links">
            <a href="/" class="nav-link">
                <span class="nav-index">01//</span>
                <span>Home</span>
            </a>
            <a href="/blog" class="nav-link">
                <span class="nav-index">02//</span>
                <span>Artículos</span>
            </a>
            <a href="/about" class="nav-link">
                <span class="nav-index">03//</span>
                <span>Sobre mí</span>
            </a>
            <a href="/contact" class="nav-link">
                <span class="nav-index">04//</span>
                <span>Contacto</span>
            </a>
        </div>

        <!-- Desktop Actions -->
        <div class="nav-actions">
            <a href="/blog" class="btn btn-outline btn-sm">
                [ EXPLORAR ]
            </a>
        </div>

        <!-- Mobile Menu Button -->
        <button 
            @click="showMobileMenu = !showMobileMenu" 
            class="mobile-menu-btn" 
            aria-label="Toggle navigation menu"
        >
            <svg x-show="!showMobileMenu" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            <svg x-show="showMobileMenu" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="display: none;">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>
    </nav>

    <!-- Mobile Drawer -->
    <div x-show="showMobileMenu" class="container mobile-drawer" style="display: none;">
        <a href="/" class="nav-link"><span class="nav-index">01//</span> Home</a>
        <a href="/blog" class="nav-link"><span class="nav-index">02//</span> Artículos</a>
        <a href="/about" class="nav-link"><span class="nav-index">03//</span> Sobre mí</a>
        <a href="/contact" class="nav-link"><span class="nav-index">04//</span> Contacto</a>
        <div style="margin-top: var(--space-3);">
            <a href="/blog" class="btn btn-primary btn-sm w-full">[ EXPLORAR BLOG ]</a>
        </div>
    </div>
</header>