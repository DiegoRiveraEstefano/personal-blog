---
import { basePath } from '../../utils/paths';

interface Props {
  title: string;
  description: string;
  canonicalURL?: URL | string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
  author?: string;
  tags?: string[];
  schema?: Record<string, any> | Record<string, any>[];
}

const {
  title,
  description,
  canonicalURL,
  image,
  type = "website",
  publishedTime,
  modifiedTime,
  author = "Diego Rivera",
  tags = [],
  schema,
} = Astro.props;

const siteTitle = "Diego Rivera | Dev Blog";
const fullTitle = title.includes("Diego Rivera") ? title : `${title} | ${siteTitle}`;

// Resolve Canonical URL
const resolvedCanonical = canonicalURL
  ? (typeof canonicalURL === 'string' ? canonicalURL : canonicalURL.toString())
  : new URL(Astro.url.pathname, Astro.site || 'https://diegoriveraestefano.github.io').toString();

// Resolve OG Image (fallback to high-res PNG banner instead of SVG)
const defaultOgImage = `${basePath}/images/og-default.png`;
const targetImage = image || defaultOgImage;
const absoluteImageUrl = targetImage.startsWith('http://') || targetImage.startsWith('https://')
  ? targetImage
  : new URL(targetImage, Astro.site || 'https://diegoriveraestefano.github.io').toString();

const isoPublishedTime = publishedTime ? new Date(publishedTime).toISOString() : undefined;
const isoModifiedTime = modifiedTime ? new Date(modifiedTime).toISOString() : isoPublishedTime;
---

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<meta name="author" content={author} />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
{tags.length > 0 && <meta name="keywords" content={tags.join(", ")} />}

<!-- Canonical & Alternate Feeds -->
<link rel="canonical" href={resolvedCanonical} />
<link rel="alternate" type="application/rss+xml" title="Diego Rivera | Dev Blog RSS Feed" href={`${basePath}/rss.xml`} />

<!-- Open Graph / Facebook / LinkedIn -->
<meta property="og:site_name" content="Diego Rivera | Dev Blog" />
<meta property="og:locale" content="es_ES" />
<meta property="og:type" content={type} />
<meta property="og:url" content={resolvedCanonical} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteImageUrl} />
<meta property="og:image:alt" content={fullTitle} />

{type === 'article' && (
  <>
    {isoPublishedTime && <meta property="article:published_time" content={isoPublishedTime} />}
    {isoModifiedTime && <meta property="article:modified_time" content={isoModifiedTime} />}
    <meta property="article:author" content={author} />
    {tags.length > 0 && <meta property="article:section" content={tags[0]} />}
    {tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
  </>
)}

<!-- Twitter Cards -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={resolvedCanonical} />
<meta property="twitter:title" content={fullTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={absoluteImageUrl} />
<meta property="twitter:image:alt" content={fullTitle} />

<!-- Structured Data (Schema.org JSON-LD) -->
{schema && (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
)}
