---
interface Props {
  label?: string;
  name?: string;
  id?: string;
  placeholder?: string;
  required?: boolean;
  value?: string;
  rows?: number;
  class?: string;
  [key: string]: any;
}

const { 
  label, 
  name, 
  id, 
  placeholder, 
  required = false, 
  value,
  rows = 4,
  class: className = '',
  ...rest 
} = Astro.props;
---

<div class={`input-group ${className}`}>
  {label && (
    <label for={id || name}>
      {label} {required && <span class="text-amber">*</span>}
    </label>
  )}
  <textarea
    name={name}
    id={id || name}
    placeholder={placeholder}
    required={required}
    rows={rows}
    {...rest}
  >{value}</textarea>
</div>