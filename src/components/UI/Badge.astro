---
interface Props {
  variant?: 'primary' | 'secondary' | 'accent' | 'success' | 'warning' | 'error' | 'info' | 'gray';
  shape?: 'rounded' | 'pill';
  size?: 'sm' | 'md';
  class?: string;
}

const { 
  variant = 'primary', 
  shape = 'rounded', 
  size = 'md',
  class: className = '' 
} = Astro.props;

const variantClasses = {
  primary: 'badge-amber',
  secondary: '',
  accent: 'badge-category',
  success: 'badge-emerald',
  warning: 'badge-amber',
  error: 'badge-amber',
  info: 'badge-category',
  gray: '',
};

const classes = ['badge', variantClasses[variant] || '', className].filter(Boolean).join(' ');
---

<span class={classes}>
  <slot />
</span>