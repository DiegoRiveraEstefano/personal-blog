---
interface Props {
  label?: string;
  type?: 'text' | 'email' | 'password' | 'number' | 'tel' | 'url' | 'search';
  name?: string;
  id?: string;
  placeholder?: string;
  required?: boolean;
  value?: string;
  class?: string;
  [key: string]: any;
}

const { 
  label, 
  type = 'text', 
  name, 
  id, 
  placeholder, 
  required = false, 
  value,
  class: className = '',
  ...rest 
} = Astro.props;
---

<div class={`input-group ${className}`}>
  {label && (
    <label for={id || name}>
      {label} {required && <span class="text-amber">*</span>}
    </label>
  )}
  <input
    type={type}
    name={name}
    id={id || name}
    placeholder={placeholder}
    required={required}
    value={value}
    {...rest}
  />
</div>