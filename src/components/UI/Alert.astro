---
interface Props {
  variant?: 'success' | 'warning' | 'error' | 'info';
  title?: string;
  class?: string;
}

const { variant = 'info', title, class: className = '' } = Astro.props;

const ledColors = {
  success: 'led-emerald',
  warning: 'led-amber',
  error: 'led-crimson',
  info: 'led-cyan',
};

const ledClass = ledColors[variant] || 'led-cyan';
---

<div class={`alert-box alert-${variant} ${className}`}>
  <span class={`led-dot ${ledClass}`} style="margin-top: 5px;"></span>
  <div style="flex: 1;">
    {title && <h4 style="font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: var(--space-1); color: var(--text-primary);">[ {title} ]</h4>}
    <div style="font-size: var(--text-xs); color: var(--text-secondary); line-height: 1.6;">
      <slot />
    </div>
  </div>
</div>