---
import Layout from '../layouts/Layout.astro';
import Header from "../components/Layout/Header.astro";
import Footer from "../components/Layout/Footer.astro";
import BlogCard from '../components/Blogs/BlogCard.astro'; 
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
---

<Layout title="Diego Rivera | Software Engineer & Backend Expert" description="Blog personal de Diego Rivera. Tutoriales profundos y artículos técnicos sobre Python, Django, Arquitectura de Software y desarrollo web moderno.">
  <Header />
  
  <!-- Hero Module: Telemetry & Core Focus -->
  <section class="hero-panel">
    <div class="container">
      <div class="hero-spec-tag">
        <span class="led-dot led-amber"></span>
        <span>SYS.SPEC // SOFTWARE ARCHITECTURE &amp; PERFORMANCE</span>
      </div>
      
      <h1 class="hero-title">
        Desarrollo con <br />
        <span class="highlight">Propósito &amp; Claridad</span>
      </h1>
      
      <p class="hero-description">
        Soy <strong class="text-primary">Diego Rivera</strong>. Exploro la intersección entre la eficiencia algorítmica, backends de alta disponibilidad y la robustez de la arquitectura en el ecosistema <span class="text-amber font-mono font-bold">Python</span>, Go y sistemas embebidos.
      </p>
      
      <div class="flex items-center gap-4 flex-wrap">
        <a href="/blog" class="btn btn-primary btn-lg">
          [ EXPLORAR ARTÍCULOS ]
        </a>
        <a href="/about" class="btn btn-outline btn-lg">
          [ MI TRAYECTORIA ]
        </a>
      </div>
    </div>
  </section>
  
  <!-- Post Grid Section -->
  <main class="container section-space">
    <div class="flex items-center justify-between" style="margin-bottom: var(--space-6); padding-bottom: var(--space-3); border-bottom: 1px solid var(--border-subtle);">
      <div class="flex items-center gap-2">
        <span class="led-dot led-cyan" style="width: 6px; height: 6px;"></span>
        <span class="font-mono uppercase text-secondary tracking-wider" style="font-size: var(--text-xs); font-weight: 600;">
          // REGISTRO DE PUBLICACIONES TÉCNICAS
        </span>
      </div>
      <span class="badge font-mono" style="font-size: var(--text-xs);">
        TOTAL: {posts.length}
      </span>
    </div>

    <section class="telemetry-grid">
      {posts.map(post => (
        <BlogCard {...post.data} />
      ))}
    </section>
  </main>
  
  <Footer />
</Layout>
