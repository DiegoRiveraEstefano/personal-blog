---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Layout/Header.astro';
import Footer from '../components/Layout/Footer.astro';
import Category from '../components/Badges/Category.astro';

const skills = {
  "Lenguajes": ["Python", "JavaScript", "TypeScript", "SQL", "C/C++", "Go", "Bash"],
  "Backend & Data": ["Django", "DRF", "FastAPI", "PostgREST", "Kafka", "Pandas", "Scikit-learn"],
  "Frontend": ["Vue.js", "SvelteKit", "HTML5", "CSS3", "Tauri"],
  "DevOps & Tools": ["Docker", "GitHub Actions", "Linux", "Git", "Nuitka"],
  "Hardware/IoT": ["Raspberry Pi", "ESP32", "I2C", "UART", "USB HID"]
};

const projects = [
  {
    title: "Sistema de Control HID & Coprocesamiento IoT",
    date: "Dic 2025",
    desc: "Sistema de control de dispositivos móviles basado en Raspberry Pi 4 + Pico en arquitectura maestro–esclavo. Implementación de comunicación UART/I2C, emulación USB HID y pipelines CI/CD para compilación cruzada ARM64.",
    tags: ["IoT", "Raspberry Pi", "Python", "C++"]
  },
  {
    title: "Clasificador de Tickets con ML",
    date: "Oct 2025",
    desc: "Microservicio para preprocesamiento y clasificación automática de tickets. Entrenamiento de modelos con Scikit-learn y exposición del servicio vía API para consumo en tiempo real.",
    tags: ["Machine Learning", "Scikit-learn", "Python", "API"]
  },
  {
    title: "Arquitectura de Servicios con Kafka y Go",
    date: "Oct 2025",
    desc: "Diseño de un backend para ingesta y procesamiento de datos IoT. Uso de Kafka para mensajería y un consumidor en Go para procesamiento concurrente de alto rendimiento.",
    tags: ["Go", "Kafka", "Backend", "Arquitectura"]
  }
];
---

<Layout title="Sobre Mí - Diego Rivera" description="Perfil profesional de Diego Rivera Estefano, Ingeniero de Software y Full Stack Developer especializado en Python.">
  <Header />
  
  <main class="section-space">
    <div class="container-prose">
      
      <!-- Hero Profile -->
      <div class="text-center section-header">
        <div class="hero-spec-tag justify-center" style="margin-bottom: var(--space-2);">
          <span class="led-dot led-emerald"></span>
          <span>ENG.PROFILE // FULL STACK &amp; BACKEND EXPERT</span>
        </div>
        <h1 style="font-size: var(--text-3xl); font-weight: 700; margin-bottom: var(--space-2);">
          Diego Rivera Estefano
        </h1>
        <p class="font-mono text-amber" style="font-size: var(--text-base); margin-bottom: var(--space-2);">
          Ingeniero de Software | Python &amp; Systems Developer
        </p>
        <div class="flex items-center justify-center gap-2 font-mono text-muted" style="font-size: var(--text-xs);">
            <span>LOC: Santiago, Chile</span>
            <span>//</span>
            <span>STATUS: DISPONIBLE</span>
        </div>
      </div>
      
      <div class="flow" style="--flow-space: var(--space-8);">
        
        <!-- Profile Summary -->
        <section class="telemetry-card">
          <div class="telemetry-card-header">
            <h2 style="font-size: var(--text-xl); font-weight: 600;" class="flex items-center gap-2">
              <span class="led-dot led-amber"></span>
              Perfil Profesional
            </h2>
            <span class="badge font-mono">[ RESUMEN ]</span>
          </div>
          <p class="text-secondary" style="line-height: 1.8;">
            Ingeniero de Software con experiencia como desarrollador Full Stack freelance. Especializado en el ecosistema <strong class="text-amber">Python (Django, FastAPI)</strong> y en la integración de soluciones de IA/ML orientadas a la optimización de procesos. Experiencia en automatización, optimización de backends, despliegue con Docker/CI/CD y trabajo con sistemas embebidos (Raspberry Pi, USB HID, microcontroladores). Enfoque en construir soluciones escalables, de alto rendimiento y arquitectura limpia.
          </p>
        </section>

        <!-- Experience -->
        <section>
            <div class="flex items-center gap-2" style="margin-bottom: var(--space-4);">
              <span class="led-dot led-cyan"></span>
              <h2 style="font-size: var(--text-xl); font-weight: 600;">Experiencia Laboral</h2>
            </div>
            
            <div class="telemetry-card">
                <div class="flex flex-col sm:flex-row justify-between items-start" style="margin-bottom: var(--space-3); gap: var(--space-2);">
                    <div>
                        <h3 style="font-size: var(--text-lg); font-weight: 600;">Desarrollador Full Stack Freelance</h3>
                        <p class="font-mono text-amber" style="font-size: var(--text-sm);">Clientes PyMEs – Chile</p>
                    </div>
                    <span class="badge font-mono">Jul 2024 – Presente</span>
                </div>
                <p class="text-secondary" style="margin-bottom: var(--space-4); font-size: var(--text-sm);">
                  Diseño y desarrollo de soluciones tecnológicas para procesos de digitalización, backend de datos y automatización empresarial.
                </p>
                <ul class="prose" style="font-size: var(--text-sm); line-height: 1.7;">
                    <li><strong>Desarrollo Web &amp; APIs:</strong> Implementación de APIs REST utilizando Django, DRF y FastAPI, integrando frontends modernos.</li>
                    <li><strong>Automatización &amp; IA:</strong> Modelos de Machine Learning (Scikit-learn) para clasificación automática de incidencias.</li>
                    <li><strong>Infraestructura:</strong> Despliegue self-hosted, Docker, Nginx y PostgreSQL con RLS.</li>
                    <li><strong>Optimización:</strong> Scripts en Python para pipelines de datos y compilación nativa con Nuitka.</li>
                </ul>
            </div>
        </section>

        <!-- Skills -->
        <section>
            <div class="flex items-center gap-2" style="margin-bottom: var(--space-4);">
              <span class="led-dot led-amber"></span>
              <h2 style="font-size: var(--text-xl); font-weight: 600;">Habilidades Técnicas</h2>
            </div>
            
            <div class="skills-grid">
                {Object.entries(skills).map(([category, items]) => (
                    <div class="telemetry-card" style="padding: var(--space-4);">
                        <h3 class="font-mono text-amber" style="font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: var(--space-3);">
                          // {category}
                        </h3>
                        <div class="flex flex-wrap gap-1">
                            {items.map(skill => (
                                <span class="badge">{skill}</span>
                            ))}
                        </div>
                    </div>
                ))}
            </div>
        </section>

        <!-- Projects -->
        <section>
            <div class="flex items-center gap-2" style="margin-bottom: var(--space-4);">
              <span class="led-dot led-cyan"></span>
              <h2 style="font-size: var(--text-xl); font-weight: 600;">Proyectos Destacados</h2>
            </div>
            
            <div class="flow" style="--flow-space: var(--space-4);">
                {projects.map(project => (
                    <div class="telemetry-card">
                        <div class="flex justify-between items-start" style="margin-bottom: var(--space-2); gap: var(--space-2);">
                            <h3 style="font-size: var(--text-base); font-weight: 600;">{project.title}</h3>
                            <span class="badge font-mono text-amber" style="font-size: 0.72rem;">{project.date}</span>
                        </div>
                        <p class="text-secondary" style="font-size: var(--text-sm); line-height: 1.6; margin-bottom: var(--space-4);">
                          {project.desc}
                        </p>
                        <div class="flex flex-wrap gap-1">
                            {project.tags.map(tag => (
                                <Category category={tag} text={tag} />
                            ))}
                        </div>
                    </div>
                ))}
            </div>
        </section>

        <!-- Education -->
        <section>
             <div class="flex items-center gap-2" style="margin-bottom: var(--space-4);">
              <span class="led-dot led-emerald"></span>
              <h2 style="font-size: var(--text-xl); font-weight: 600;">Educación &amp; Formación</h2>
            </div>
            
            <div class="telemetry-card" style="border-left: 3px solid var(--signal-amber);">
                <h3 style="font-size: var(--text-base); font-weight: 600;">Ingeniería en Informática / Software</h3>
                <p class="text-secondary" style="font-size: var(--text-sm);">Centro de Formación Inacap</p>
                <p class="font-mono text-muted" style="font-size: var(--text-xs); margin-top: var(--space-1);">Egreso: Diciembre 2025</p>
            </div>
        </section>
        
        <!-- Connect Console -->
        <div class="telemetry-card text-center" style="padding: var(--space-8); margin-top: var(--space-6);">
          <div class="hero-spec-tag justify-center" style="margin-bottom: var(--space-2);">
            <span class="led-dot led-amber"></span>
            <span>DISPONIBLE PARA PROYECTOS &amp; CONSULTORÍA</span>
          </div>
          <h3 style="font-size: var(--text-xl); font-weight: 600; margin-bottom: var(--space-3);">¿Te interesa colaborar?</h3>
          <p class="text-secondary" style="max-width: 55ch; margin-inline: auto; margin-bottom: var(--space-6); font-size: var(--text-sm);">
            Siempre estoy abierto a discutir nuevos proyectos de arquitectura backend, sistemas embebidos o desafíos de optimización de rendimiento.
          </p>
          <div class="flex flex-wrap justify-center gap-3">
            <a href="mailto:diego.rivera.estefano@gmail.com" class="btn btn-primary">
              [ CONTACTAR POR EMAIL ]
            </a>
            <a href="https://linkedin.com/in/diego-rivera-estefano" target="_blank" rel="noopener noreferrer" class="btn btn-outline">
              [ LINKEDIN ]
            </a>
            <a href="https://github.com/DiegoRiveraEstefano" target="_blank" rel="noopener noreferrer" class="btn btn-outline">
              [ GITHUB ]
            </a>
          </div>
        </div>

      </div>
    </div>
  </main>
  
  <Footer />
</Layout>