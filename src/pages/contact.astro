---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Layout/Header.astro';
import Footer from '../components/Layout/Footer.astro';
import Input from '../components/UI/Input.astro';
import Textarea from '../components/UI/Textarea.astro';
import Button from '../components/UI/Button.astro';
import Alert from '../components/UI/Alert.astro';
---

<Layout title="Contacto - Diego Rivera" description="Ponte en contacto para proyectos, consultorías o arquitectura de software.">
  <Header />
  
  <main class="section-space">
    <div class="container-narrow">
      <div class="text-center section-header">
        <div class="hero-spec-tag justify-center" style="margin-bottom: var(--space-2);">
          <span class="led-dot led-cyan"></span>
          <span>COMMS.CHANNEL // CANAL DIRECTO DE COMUNICACIÓN</span>
        </div>
        <h1 style="font-size: var(--text-3xl); font-weight: 700; margin-bottom: var(--space-2);">
          Iniciar Contacto
        </h1>
        <p style="margin-inline: auto;">
          ¿Tienes un proyecto en mente, consultas de arquitectura o buscas colaboración técnica?
        </p>
      </div>
      
      <div class="telemetry-card">
         <form class="flow" style="--flow-space: var(--space-4);" onsubmit="event.preventDefault();">
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: var(--space-4);">
                <Input label="Nombre // Identificador" name="name" placeholder="Tu nombre" required />
                <Input label="Email de Contacto" type="email" name="email" placeholder="tu.email@dominio.com" required />
            </div>
            
            <Input label="Asunto // Proyecto" name="subject" placeholder="Consulta técnica o proyecto" required />
            
            <Textarea label="Mensaje // Especificación" name="message" placeholder="Cuéntame sobre los requerimientos, stack técnico o alcance del proyecto..." rows={5} required />
            
            <div style="padding-top: var(--space-2);">
                <Button type="submit" variant="primary" class="w-full">
                    [ TRANSMITIR MENSAJE ]
                </Button>
            </div>
         </form>

         <div style="margin-top: var(--space-6);">
            <Alert variant="info" title="Canal Directo">
                Para comunicaciones de alta prioridad, también puedes escribir directamente a <a href="mailto:diego.rivera.estefano@gmail.com" class="text-amber" style="text-decoration: underline;">diego.rivera.estefano@gmail.com</a>.
            </Alert>
         </div>
      </div>

    </div>
  </main>
  
  <Footer />
</Layout>