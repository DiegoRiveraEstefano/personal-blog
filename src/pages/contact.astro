---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Layout/Header.astro';
import Footer from '../components/Layout/Footer.astro';

const contactChannels = [
  {
    tag: "COMMS // 01",
    title: "Correo Electrónico",
    value: "diego.rivera.estefano@gmail.com",
    description: "Canal directo para propuestas de arquitectura, consultoría técnica y nuevos proyectos.",
    buttonText: "[ ENVIAR EMAIL ]",
    buttonHref: "mailto:diego.rivera.estefano@gmail.com",
    external: false,
    led: "led-amber",
    icon: `<svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`
  },
  {
    tag: "COMMS // 02",
    title: "LinkedIn",
    value: "in/diego-rivera-estefano",
    description: "Red profesional, trayectoria en ingeniería de software, publicaciones y networking.",
    buttonText: "[ VER PERFIL ]",
    buttonHref: "https://linkedin.com/in/diego-rivera-estefano",
    external: true,
    led: "led-cyan",
    icon: `<svg width="22" height="22" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>`
  },
  {
    tag: "COMMS // 03",
    title: "GitHub",
    value: "DiegoRiveraEstefano",
    description: "Repositorios, implementaciones de algoritmos, arquitecturas backend y código abierto.",
    buttonText: "[ EXPLORAR CÓDIGO ]",
    buttonHref: "https://github.com/DiegoRiveraEstefano",
    external: true,
    led: "led-emerald",
    icon: `<svg width="22" height="22" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>`
  },
  {
    tag: "COMMS // 04",
    title: "Portafolio Web",
    value: "diegoriveraestefano.github.io/portafolio",
    description: "Proyectos en producción, interfaces, arquitectura de sistemas y casos de estudio interactivos.",
    buttonText: "[ VISITAR PORTAFOLIO ]",
    buttonHref: "https://diegoriveraestefano.github.io/portafolio/",
    external: true,
    led: "led-amber",
    icon: `<svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>`
  }
];
---

<Layout title="Contacto & Redes" description="Canales de comunicación directa, perfiles profesionales y portafolio técnico de Diego Rivera.">
  <Header />
  
  <main class="section-space">
    <div class="container">
      
      <!-- Section Header -->
      <div class="text-center section-header">
        <div class="hero-spec-tag justify-center" style="margin-bottom: var(--space-2);">
          <span class="led-dot led-cyan"></span>
          <span>COMMS.ROUTING // CANALES DIRECTOS DE COMUNICACIÓN</span>
        </div>
        <h1 style="font-size: var(--text-3xl); font-weight: 700; margin-bottom: var(--space-2);">
          Canales de Contacto
        </h1>
        <p style="max-width: 55ch; margin-inline: auto;">
          Acceso directo para consultas de ingeniería, colaboraciones técnicas, oportunidades profesionales y revisión de proyectos.
        </p>
      </div>
      
      <!-- Cards Grid -->
      <div class="grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: var(--space-6); max-width: 1040px; margin-inline: auto;">
        {contactChannels.map((channel) => (
          <div class="telemetry-card" style="display: flex; flex-direction: column; justify-content: space-between; min-height: 250px;">
            <div>
              <div class="telemetry-card-header" style="margin-bottom: var(--space-4);">
                <div class="flex items-center gap-2">
                  <span class={`led-dot ${channel.led}`}></span>
                  <span class="font-mono text-secondary" style="font-size: var(--text-xs); font-weight: 600;">
                    {channel.tag}
                  </span>
                </div>
                <div class="text-secondary" set:html={channel.icon} />
              </div>
              
              <h2 style="font-size: var(--text-xl); font-weight: 700; margin-bottom: var(--space-1); color: var(--text-primary);">
                {channel.title}
              </h2>
              
              <div class="font-mono text-amber" style="font-size: var(--text-xs); margin-bottom: var(--space-3); word-break: break-all; opacity: 0.95;">
                {channel.value}
              </div>
              
              <p class="text-secondary" style="font-size: var(--text-sm); line-height: 1.6; margin-bottom: var(--space-6);">
                {channel.description}
              </p>
            </div>

            <div style="border-top: 1px solid var(--border-subtle); padding-top: var(--space-4); margin-top: auto;">
              <a 
                href={channel.buttonHref} 
                class="btn btn-outline btn-sm w-full"
                target={channel.external ? "_blank" : undefined}
                rel={channel.external ? "noopener noreferrer" : undefined}
              >
                {channel.buttonText}
              </a>
            </div>
          </div>
        ))}
      </div>

    </div>
  </main>
  
  <Footer />
</Layout>