---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Layout/Header.astro';
import Footer from '../components/Layout/Footer.astro';
import BlogCard from '../components/Blogs/BlogCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const categories = ['All', 'Python', 'Django', 'JavaScript', 'DevOps', 'Database'];

// Prepare data for Alpine.js
const postsJSON = posts.map(post => ({
    slug: post.data.slug,
    title: post.data.title,
    description: post.data.description,
    tags: post.data.tags
}));
---

<Layout title="Blog & Recursos Técnicos" description="Artículos profundos, tutoriales y guías sobre desarrollo backend, Python, Django y mejores prácticas de ingeniería de software.">
  <Header />
  
  <main class="section-space">
    <div class="container">
      
      <!-- Section Header -->
      <div class="text-center section-header">
        <div class="hero-spec-tag justify-center" style="margin-bottom: var(--space-2);">
          <span class="led-dot led-amber"></span>
          <span>INDEX // REGISTRO TÉCNICO &amp; BITÁCORA</span>
        </div>
        <h1 style="font-size: var(--text-3xl); font-weight: 700; margin-bottom: var(--space-3);">
          Artículos &amp; Notas de Arquitectura
        </h1>
        <p style="margin-inline: auto;">
          Análisis profundos sobre rendimiento backend, patrones de concurrencia y buenas prácticas en Python.
        </p>
      </div>
      
      <!-- Alpine.js Logic -->
      <div x-data={`{
        allPosts: ${JSON.stringify(postsJSON)},
        search: '',
        currentCategory: 'All',
        currentPage: 1,
        postsPerPage: 6,
        
        get filteredPosts() {
            return this.allPosts.filter(post => {
                const matchesCategory = this.currentCategory === 'All' || post.tags.includes(this.currentCategory);
                const matchesSearch = post.title.toLowerCase().includes(this.search.toLowerCase()) || 
                                    post.description.toLowerCase().includes(this.search.toLowerCase());
                return matchesCategory && matchesSearch;
            });
        },
        
        get totalPages() {
            return Math.ceil(this.filteredPosts.length / this.postsPerPage);
        },
        
        get paginatedPosts() {
            const start = (this.currentPage - 1) * this.postsPerPage;
            const end = start + this.postsPerPage;
            return this.filteredPosts.slice(start, end);
        },
        
        get visibleSlugs() {
            return this.paginatedPosts.map(p => p.slug);
        },

        nextPage() {
            if (this.currentPage < this.totalPages) this.currentPage++;
        },

        prevPage() {
            if (this.currentPage > 1) this.currentPage--;
        },

        goToPage(page) {
            this.currentPage = page;
        },
        
        init() {
            this.$watch('search', () => this.currentPage = 1);
            this.$watch('currentCategory', () => this.currentPage = 1);
        }
      }`}>

        <!-- Controls Container -->
        <div style="margin-bottom: var(--space-10); display: flex; flex-direction: column; gap: var(--space-6);">
            
            <!-- Search Bar -->
            <div class="search-wrapper">
                <input 
                    x-model="search"
                    type="text" 
                    placeholder="[ BUSCAR POR PALABRA CLAVE... ]" 
                    class="search-input"
                />
                <svg class="search-icon" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
            </div>

            <!-- Categories -->
            <div class="flex flex-wrap gap-2 justify-center">
                {categories.map(category => (
                    <button 
                      @click={`currentCategory = '${category}'`}
                      :class={`currentCategory === '${category}' ? 'filter-pill is-active' : 'filter-pill'`}
                    >
                      [ {category.toUpperCase()} ]
                    </button>
                ))}
            </div>

        </div>
        
        <!-- Blog Grid -->
        <div class="telemetry-grid" style="min-height: 400px;">
          {posts.map(post => (
            <div 
              x-show={`visibleSlugs.includes('${post.data.slug}')`}
              style="display: contents;" 
            >
              <BlogCard {...post.data} />
            </div>
          ))}
          
          <!-- No Results Message -->
          <div x-show="filteredPosts.length === 0" class="text-center" style="grid-column: 1 / -1; padding-block: var(--space-12); display: none;">
                <div class="alert-box alert-warning" style="max-width: 480px; margin-inline: auto; text-align: left;">
                    <span class="led-dot led-amber" style="margin-top: 5px;"></span>
                    <div>
                        <strong style="display: block; font-family: var(--font-mono); font-size: var(--text-sm);">[ TELEMETRÍA // 0 RESULTADOS ]</strong>
                        <p style="font-size: var(--text-xs); margin-top: var(--space-1);">No se encontraron especificaciones que coincidan con la búsqueda o categoría.</p>
                    </div>
                </div>
          </div>
        </div>
        
        <!-- Pagination Controls -->
        <div class="pagination-container" x-show="totalPages > 1" x-cloak>
            <button 
                @click="prevPage" 
                :disabled="currentPage === 1"
                class="pagination-btn"
                aria-label="Página anterior"
            >
                ←
            </button>
            
            <template x-for="page in totalPages" :key="page">
                <button 
                    @click="goToPage(page)"
                    :class="currentPage === page ? 'pagination-btn is-active' : 'pagination-btn'"
                    x-text="page"
                ></button>
            </template>

            <button 
                @click="nextPage" 
                :disabled="currentPage === totalPages"
                class="pagination-btn"
                aria-label="Página siguiente"
            >
                →
            </button>
        </div>

      </div>

    </div>
  </main>
  
  <Footer />
</Layout>