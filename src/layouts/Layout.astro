---
import "../styles/main.css";
import "../styles/viewTransition.css";
import SEO from "../components/SEO/SEO.astro";
import { basePath } from "../utils/paths";

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalURL?: URL | string;
  type?: "website" | "article";
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
  author?: string;
  tags?: string[];
  schema?: Record<string, any> | Record<string, any>[];
}

const {
  title,
  description = "Bitácora técnica sobre diseño de backends escalables, optimización algorítmica, concurrencia y buenas prácticas en Python, Django y sistemas distribuidos.",
  image,
  canonicalURL,
  type = "website",
  publishedTime,
  modifiedTime,
  author = "Diego Rivera",
  tags = [],
  schema,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <!-- Global Metadata -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${basePath}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO & Social Open Graph / Twitter / Schema.org -->
    <SEO
      title={title}
      description={description}
      image={image}
      canonicalURL={canonicalURL}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      author={author}
      tags={tags}
      schema={schema}
    />

    <!-- Fonts & Scripts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="sitemap" href={`${basePath}/sitemap-index.xml`} />
    <script
      src="https://unpkg.com/quicklink@3.0.1/dist/quicklink.umd.js"
      type="text/partytown"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Theme Initializer (Zero-Flicker) -->
    <script is:inline>
      const getTheme = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
      };
      document.documentElement.setAttribute('data-theme', getTheme());
      document.addEventListener('astro:after-swap', () => {
        document.documentElement.setAttribute('data-theme', getTheme());
      });
    </script>
  </head>
  <body class="bg-grid-blueprint" x-data="{ showMobileMenu: false }">
    <slot />
    <script>
      quicklink.listen();
    </script>
  </body>
</html>
